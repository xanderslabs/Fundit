# Inputs for script/Deploy.s.sol. Copy to .env and fill in. Never commit .env.
#
# Simulate only (no transaction is sent):
#   source .env && arc-forge script script/Deploy.s.sol --fork-url arc

# Private key of the deploying account (0x-prefixed hex). It pays gas in USDC on Arc.
DEPLOYER_PRIVATE_KEY=
# Factory owner (Ownable2Step). Use a multisig.
OWNER=
# Address that receives claimed fees. Must not be zero.
TREASURY=
# Donation fee in basis points, 0 to 500.
DONATION_FEE_BPS=
# Withdrawal fee in basis points, 0 to 500.
WITHDRAW_FEE_BPS=
# CCTP domains where EURC campaigns may pay out, comma-separated. Duplicates are dropped.
# Arc (26) is rejected because Arc payouts are plain transfers and need no entry.
# The list is fixed at deploy and has no setter.
# Default is empty: on 2026-10-16 the Arc TokenMinterV2 had no EURC burn limit and no
# EURC token links, and depositForBurn(EURC) reverted "Burn token not supported" for
# domains 0, 1, 6 and 14. Recheck on a fork before adding any domain.
EURC_PAYOUT_DOMAINS=
