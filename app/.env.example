# All values are public. Never put a secret in a VITE_ variable: it ships in the bundle.

# Arc network: mainnet (default when empty) or testnet. Every chain id, token and contract address, RPC and
# Circle API URL comes from this one value (NETWORK in src/config.ts).
# A production build (npm run build) refuses testnet, because production builds are for fundit.fun. For a
# test site only, also set VITE_ALLOW_TESTNET_BUILD=1. Never set it where the fundit.fun build runs.
VITE_ARC_NETWORK=
VITE_ALLOW_TESTNET_BUILD=

# Reown (WalletConnect) project id from dashboard.reown.com
VITE_REOWN_PROJECT_ID=

# Circle client key for Fundit accounts (passkeys). Sign-in is passkey only, so a production build
# (npm run build) fails without it. Create it in Circle Console under Keys > Client Key.
# Production: passkey domain and allowed domain fundit.fun. Development: a separate key for localhost.
# A passkey only works on the domain its key names. Example: VITE_CIRCLE_CLIENT_KEY=<your-client-key>
VITE_CIRCLE_CLIENT_KEY=

# CampaignFactory on the chosen Arc network and the block it was deployed in. Set both or neither.
# A production build (npm run build) fails if either one, or VITE_REOWN_PROJECT_ID, is empty.
VITE_FACTORY_ADDRESS=
VITE_FACTORY_DEPLOY_BLOCK=

# RPC overrides. If you change a host, add it to connect-src in public/_headers.
# Leave VITE_ARC_RPC_URL empty to use the network's own Arc RPC (rpc.mainnet.arc.io or rpc.testnet.arc.io).
# If you set it, it must point at the network chosen above.
VITE_ARC_RPC_URL=
VITE_MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com

# Set to 1 to offer Add money from another chain (bridging USDC into the Fundit account with CCTP). Off by
# default. Cross-chain payouts in Manage do not depend on it.
VITE_CROSSCHAIN=
