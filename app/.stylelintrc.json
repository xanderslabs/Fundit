{
  "plugins": ["stylelint-declaration-strict-value"],
  "ignoreFiles": [
    "src/styles/base.css",
    "src/styles/campaigns.css",
    "src/styles/create.css",
    "src/styles/donate.css",
    "src/styles/embed.css",
    "src/styles/manage.css",
    "src/styles/share.css"
  ],
  "rules": {
    "scale-unlimited/declaration-strict-value": [
      ["font-size", "/^margin/", "/^padding/", "gap", "row-gap", "column-gap", "/radius$/", "color", "/^background/"],
      {
        "ignoreValues": {
          "font-size": "/^(inherit|-?[\\d.]+%)$/",
          "/^margin/": "/^((0|auto|inherit|-?[\\d.]+%|var\\(--[\\w-]+\\))(\\s+|$))+$/",
          "/^padding/": "/^((0|inherit|[\\d.]+%|var\\(--[\\w-]+\\))(\\s+|$))+$/",
          "gap": "/^((0|inherit|[\\d.]+%|var\\(--[\\w-]+\\))(\\s+|$))+$/",
          "row-gap": "/^(0|inherit|[\\d.]+%)$/",
          "column-gap": "/^(0|inherit|[\\d.]+%)$/",
          "/radius$/": "/^((0|inherit|[\\d.]+%|var\\(--[\\w-]+\\))(\\s+|$))+$/",
          "color": "/^(?!.*#[0-9a-fA-F]{3,8}\\b)/",
          "/^background/": "/^(?!.*#[0-9a-fA-F]{3,8}\\b)/"
        },
        "message": "Use a token from tokens.css for \"${property}\" instead of \"${value}\"."
      }
    ]
  }
}
