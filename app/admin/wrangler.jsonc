{
	// The admin panel at admin.fundit.fun. The Worker (worker/index.ts) runs before every request, so no panel file
	// is served without an owner session.
	"name": "fundit-admin",
	"compatibility_date": "2026-10-17",
	"main": "./worker/index.ts",
	"assets": {
		"directory": "../dist-admin/",
		"binding": "ASSETS",
		"run_worker_first": true,
		// Unknown paths get the Worker's 404, never a page.
		"not_found_handling": "none",
		// Files are served at their exact path. The default would redirect /login.html to /login, which the Worker
		// does not serve without a session.
		"html_handling": "none"
	},
	// Only admin.fundit.fun: no workers.dev address and no preview URLs.
	"workers_dev": false,
	"preview_urls": false,
	// One deployment covers Arc mainnet and testnet, so there is no network variable. The secrets
	// ADMIN_SESSION_SECRET (base64, at least 32 bytes) and TURNSTILE_SECRET are set with `wrangler secret put`.
	// The Worker refuses every /api/admin call while one is missing or wrong.
	// keep_vars stops a deploy from removing the variables set in Cloudflare.
	"keep_vars": true,
	"vars": { "ADMIN_ORIGIN": "https://admin.fundit.fun" },
	// Sign-in nonces (migrations/). The owner fills in database_id from `wrangler d1 create fundit-admin`.
	"d1_databases": [
		{
			"binding": "ADMIN_DB",
			"database_name": "fundit-admin",
			"database_id": "5b45d35c-a171-45d6-8128-d900e70a8330",
			"migrations_dir": "migrations"
		}
	],
	// Per IP for nonce and login.
	"ratelimits": [
		{
			"name": "ADMIN_LIMIT",
			"namespace_id": "1002",
			"simple": { "limit": 10, "period": 60 }
		}
	],
	// Health checks and owner-event alerts (worker/cron.ts). TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID are secrets.
	"triggers": { "crons": ["*/5 * * * *"] },
	"routes": [{ "pattern": "admin.fundit.fun", "custom_domain": true }]
}
