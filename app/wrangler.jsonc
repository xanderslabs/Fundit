{
	// The Worker script (worker/index.ts) answers /api/ucw/* for email accounts and hands every other request to
	// the static files.
	"name": "fundit",
	"compatibility_date": "2026-10-17",
	"main": "./worker/index.ts",
	"assets": {
		"directory": "./dist/",
		"binding": "ASSETS",
		// Only /api/* runs the Worker first. Everything else is served straight from the files.
		"run_worker_first": ["/api/*"],
		// Unknown paths serve /index.html with 200, so React Router handles them.
		"not_found_handling": "single-page-application"
	},
	// The variables NETWORK (testnet or mainnet), FACTORY_ADDRESS and SITE_ORIGIN are set in Cloudflare, not here, so
	// the network switch is an environment change. They must match the site build (VITE_ARC_NETWORK,
	// VITE_FACTORY_ADDRESS). The Worker refuses every /api/ucw call while one is missing or wrong. The secrets
	// CIRCLE_API_KEY and TURNSTILE_SECRET are set with `wrangler secret put`. keep_vars stops a deploy from removing
	// the variables set in Cloudflare.
	"keep_vars": true,
	// Per IP for email-token and sign-transaction, and per email address for email-token.
	"ratelimits": [
		{
			"name": "UCW_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 }
		}
	],
	// fundit.fun is the permanent home.
	"routes": [
		{ "pattern": "fundit.fun", "custom_domain": true },
		{ "pattern": "www.fundit.fun", "custom_domain": true }
	]
}
