{
	// The Worker script (worker/index.ts) answers /api/ucw/* for email accounts and hands every other request to
	// the static files.
	"name": "fundit",
	"compatibility_date": "2026-10-17",
	"main": "./worker/index.ts",
	"assets": {
		"directory": "./dist/",
		"binding": "ASSETS",
		// Only /api/* runs the Worker first. Everything else is served straight from the files.
		"run_worker_first": ["/api/*"],
		// Unknown paths serve /index.html with 200, so React Router handles them.
		"not_found_handling": "single-page-application"
	},
	// Public values. The secrets CIRCLE_API_KEY and TURNSTILE_SECRET are set with `wrangler secret put`. NETWORK
	// and FACTORY_ADDRESS must match the site build (VITE_ARC_NETWORK, VITE_FACTORY_ADDRESS); the Worker refuses
	// every /api/ucw call when one is missing or wrong.
	"vars": {
		"NETWORK": "testnet",
		"FACTORY_ADDRESS": "0x6890D40a9A472D0d05aDb5938D85B07059ad54ab",
		"SITE_ORIGIN": "https://fundit.fun"
	},
	// Keep any variable set in the dashboard that is not listed above.
	"keep_vars": true,
	// Per IP for email-token and sign-transaction, and per email address for email-token.
	"ratelimits": [
		{
			"name": "UCW_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 }
		}
	],
	// fundit.fun is the permanent home (also the Circle passkey domain).
	"routes": [
		{ "pattern": "fundit.fun", "custom_domain": true },
		{ "pattern": "www.fundit.fun", "custom_domain": true }
	]
}
