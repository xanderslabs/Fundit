{
  "name": "fundit-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run lint:css && vitest run",
    "lint:css": "stylelint \"src/**/*.css\"",
    "e2e": "playwright test",
    "e2e:make-account": "playwright test --config playwright.make-account.config.ts",
    "e2e:recovery": "playwright test --config playwright.recovery.config.ts",
    "abis": "node scripts/gen-abis.mjs"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "1.19.0",
    "@circle-fin/bridge-kit": "1.15.2",
    "@circle-fin/modular-wallets-core": "1.0.16",
    "@circle-fin/w3s-pw-web-sdk": "1.1.11",
    "@reown/appkit": "1.8.24",
    "@reown/appkit-adapter-wagmi": "1.8.24",
    "@scure/bip39": "1.6.0",
    "@tanstack/react-query": "5.104.0",
    "@wagmi/core": "3.6.5",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "viem": "2.57.2",
    "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "stylelint": "17.16.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vite-plugin-node-polyfills": "0.28.0",
    "vitest": "5.0.3"
  }
}
